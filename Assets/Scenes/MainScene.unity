    \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0433\u0440\u0430\u043D\u0438\u0446
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438, \u0430 \u0438\u0437
    \u043D\u0435\u0451 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0434\u043D\u044F.  \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u0442 0 \u0434\u043E
    100 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432.\n\n\u041D\u0438\u0436\u043D\u044F\u044F
    \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430
    - \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u044D\u0442\u043E\u0433\u043E
    \u0447\u0438\u0441\u043B\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0431\u0443\u0434\u0435\u0442 100%, \u0430 \u043B\u044E\u0431\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u043D\u0438\u0436\u0435 - \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0446\u0435\u043D\u0442.\n\n\u041D\u0438\u0436\u043D\u044F\u044F
    \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430
    - \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u044D\u0442\u043E\u0433\u043E
    \u0447\u0438\u0441\u043B\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u0442\u0438. \u0422. \u0435.
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u043D\u0438\u0436\u0435 =>
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    0%, \u0432\u044B\u0448\u0435 => \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0443\u043B\u044F.\n\n\u0412\u0435\u0440\u0445\u043D\u044F\u044F
    \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430
    - \u0435\u0441\u043B\u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0432\u044B\u0448\u0435 \u043D\u0435\u0451, \u0442\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0431\u0443\u0434\u0435\u0442 \u043C\u0435\u043D\u044C\u0448\u0435 100%.\n\n\u0412\u0435\u0440\u0445\u043D\u044F\u044F
    \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430
    - \u0435\u0441\u043B\u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0432\u044B\u0448\u0435 \u043D\u0435\u0451, \u0442\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0431\u0443\u0434\u0435\u0442 0%."
  m_isRightToLeft: 0
